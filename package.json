{
  "name": "notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:connections": "node --experimental-strip-types --test tests/agent-connections.test.mjs",
    "test:tasks": "node --experimental-strip-types --test tests/task-actions.test.mjs",
    "test:trash": "node --experimental-strip-types --test tests/task-trash.test.mjs",
    "test:workstreams": "node --experimental-strip-types --test tests/workstream-actions.test.mjs",
    "test:calendar": "node --experimental-strip-types --test tests/calendar-sync.test.mjs",
    "test:plan": "node --experimental-strip-types --test tests/day-plan.test.mjs",
    "test:email-review": "node --experimental-strip-types --test tests/email-review.test.mjs",
    "test:sitemap-review": "node --experimental-strip-types --test tests/sitemap-review.test.mjs",
    "test:refinements": "node --experimental-strip-types --test tests/refinement-review.test.mjs tests/refinement-store.test.mjs",
    "check:email-review-edge": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2023 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --lib ES2023,DOM tests/whoop-edge-runtime.d.ts tests/email-review-edge-runtime.d.ts supabase/functions/codex-api/index.ts supabase/functions/executive-assistant-mcp/index.ts",
    "test:whoop": "node --experimental-strip-types --test tests/whoop.test.mjs",
    "check:whoop-edge": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2023 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --lib ES2023,DOM tests/whoop-edge-runtime.d.ts supabase/functions/whoop/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@blocknote/core": "^0.48.1",
    "@blocknote/mantine": "^0.48.1",
    "@blocknote/react": "^0.48.1",
    "@supabase/supabase-js": "^2.103.3",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "diff": "^9.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "ical.js": "2.0.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
